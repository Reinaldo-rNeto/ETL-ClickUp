        "id": "90130233326045",
        "comment": [
            {
                "text": "SELECT L.LogEntryId as id_log, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-dd9031d0-834d-4fad-9ed4-f66f2eadd188"
                }
            },
            {
                "text": "L.ReportID as id_relatorio, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-b0fd1738-ff50-4a52-a3e8-d6d7e9dbd6e5"
                }
            },
            {
                "text": "C.ItemID AS id_item, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-15cdddde-098a-4f12-9f57-d032c46765ec"
                }
            },
            {
                "text": "C.Path AS caminho, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-5d08c420-3985-419d-a3b6-9164a3e0bc64"
                }
            },
            {
                "text": "C.Name",
                "attributes": {
                    "link": "http://C.Name"
                }
            },
            {
                "text": " AS nome_item,",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-75092d2d-80d6-42aa-bcf8-8839589eec35"
                }
            },
            {
                "text": "SUBSTRING(C.Path, CHARINDEX('/', C.Path)+1, IIF(CHARINDEX('/', C.Path,2) > 0 ,CHARINDEX('/', C.Path,2) - 2, LEN(C.Path))) AS item_raiz,",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-c4fd11d8-434f-43d8-8426-774952b8d06d"
                }
            },
            {
                "text": "c.ParentID AS id_item_pai, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-adc1e0f4-0deb-40a8-b93b-d9c1131a1f5e"
                }
            },
            {
                "text": "C.Type AS tipo_item, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-6d33f4ae-cc88-4d3b-9400-432afe11b420"
                }
            },
            {
                "text": "C.PolicyID AS id_politica,",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-aa941892-fc25-43ba-9b29-948d1fbfb64b"
                }
            },
            {
                "text": "S.UserID AS id_usuario,",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-45a7aa16-c2b0-480d-bc4b-9c02df875d27"
                }
            },
            {
                "text": "L.username login_usuario_log, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-03c19562-0dd7-485e-9ad9-f9aebc536ad8"
                }
            },
            {
                "text": "S.UserName as login_usuario, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-2bd0db11-4c2a-4071-8085-d2a51b6dcce9"
                }
            },
            {
                "text": "FORMAT(L.TimeStart, 'yyyMMdd') as data_log, ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-8c82cfcb-3857-4227-92c8-3f563908b9d0"
                }
            },
            {
                "text": "convert(char(8), L.TimeStart, 108) as hora_log,",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-5777bd64-4785-42c1-a5ef-677ff66dd92a"
                }
            },
            {
                "text": "ReportAction as cod_acao ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-74da41e5-bdf8-4371-af20-b9729f097f48"
                }
            },
            {
                "text": "FROM ExecutionLogStorage L ",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-615f9422-747f-4eb5-be18-eb50b704289e"
                }
            },
            {
                "text": "FULL JOIN Catalog C ON L.ReportID = C.ItemID",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-7f74731c-4e92-4bf2-85dd-5d469f4a8e4c"
                }
            },
            {
                "text": "FULL JOIN Users S ON SUBSTRING(S.username, CHARINDEX('\\', S.username)+1, LEN(S.username)) = SUBSTRING(L.username, CHARINDEX('\\', L.username)+1, LEN(L.username))",
                "attributes": {}
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-6b1afe76-4d3d-47ee-b83d-582a83954b59"
                }
            },
            {
                "text": "\n",
                "attributes": {
                    "block-id": "block-d4df986f-0487-41c8-9b92-683366fbc382"
                }
            },
            {
                "text": "where S.UserName like '%hugo.fgomes%'",
                "attributes": {}
            },
